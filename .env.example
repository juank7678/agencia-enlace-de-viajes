# Supabase (Project Settings → API). La anon key es pública por diseño:
# la seguridad la dan las políticas RLS de supabase/migrations.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp/teléfono de la agencia (opcional; por defecto +573226136377)
VITE_ADMIN_WHATSAPP=+573226136377

# ⚠️ Toda variable VITE_* termina en el JavaScript público: nunca pongas aquí
# claves secretas (service_role, contraseñas, API keys privadas).
